{
  "version": "2.0.0",
  "options": {
    "env": {
      "PATH": "${env:HOME}/.cargo/bin:${env:PATH}"
    }
  },
  "tasks": [
    {
      "label": "check all",
      "type": "shell",
      "command": "make check",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "fmt",
      "type": "shell",
      "command": "make fmt",
      "problemMatcher": []
    },
    {
      "label": "clippy",
      "type": "shell",
      "command": "make clippy",
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "test",
      "type": "shell",
      "command": "make test",
      "group": "test",
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "build",
      "type": "shell",
      "command": "make build",
      "problemMatcher": [
        "$rustc"
      ]
    }
  ]
}